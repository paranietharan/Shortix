# ==============================================================================
# Application Settings
# ==============================================================================
APP_ENV=development
PORT=8080
BASE_URL=http://localhost:8080

# ==============================================================================
# Database Configuration (PostgreSQL)
# ==============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=shortix
POSTGRES_PORT=5432
# For Docker Compose use db:5432; for local host execution use localhost:5432
DATABASE_URL=postgres://postgres:password@db:5432/shortix?sslmode=disable

# ==============================================================================
# Redis Configuration
# ==============================================================================
REDIS_PORT=6379
# For Docker Compose use redis:6379; for local host execution use localhost:6379
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# ==============================================================================
# Mailpit (Email Testing in Docker) & SMTP Configuration
# ==============================================================================
# Mailpit exposed ports on host
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# SMTP settings for API container
# For Docker Compose with Mailpit, use host 'mailpit' and port '1025' (no auth needed)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@shortix.local
SMTP_FROM_NAME=Shortix

# ==============================================================================
# Authentication & JWT Configuration
# ==============================================================================
JWT_SECRET=1b54ca0bb8017a3a639ad20632bf2b8b99b71f63
BCRYPT_COST=12

# Token TTLs (in Go duration format: e.g., 15m, 720h, 10s)
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
EMAIL_VERIFY_OTP_TTL=10m
PASSWORD_RESET_OTP_TTL=10m
PASSWORD_RESET_TEMP_TTL=15m

# ==============================================================================
# Rate Limiting
# ==============================================================================
RATE_LIMIT_WINDOW=1m
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_FORGOT_PASSWORD_MAX=5

# ==============================================================================
# Database Migrations and Seeding
# ==============================================================================
MIGRATION_RUN=true
RUN_MIGRATIONS=true
RUN_SEED=true

SEED_ADMIN_EMAIL=admin@shortix.com
SEED_ADMIN_PASSWORD=Admin@12345
SEED_USER_EMAIL=user@shortix.com
SEED_USER_PASSWORD=User@12345